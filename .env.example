# Set these as environment variables in the hosting dashboard; do not commit real secrets.
SECRET_KEY=replace-with-a-long-random-secret
DB_PATH=/data/hawaii_travel.db
COOKIE_SECURE=1
ADMIN_USERNAME=your_admin_username
ADMIN_FULL_NAME=Your Name
ADMIN_EMAIL=your-recovery-email@example.com
ADMIN_PASSWORD=use-a-unique-password-at-least-9-characters

# SMTP settings enable self-service password recovery by email.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=salumkarume28@gmail.com
SMTP_PASSWORD=your-email-app-password
SMTP_FROM=salumkarume28@gmail.com
PUBLIC_BASE_URL=https://your-hosted-domain.example
